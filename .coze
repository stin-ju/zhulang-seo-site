[project]
entrypoint = "index.html"
requires = [ "nodejs-24" ]

[dev]
build = ["bash", "-c", "pnpm install && pip3 install -r scripts/requirements.txt -q"]
run = [
  "node",
  "server.js"
]

[deploy]
build = ["bash", "-c", "pnpm install && pip3 install -r scripts/requirements.txt -q"]
run = [
  "node",
  "server.js"
]
